      "refersTo": "button-stub",
      "description": "Primary action: a carbon ticket stub with notched ends.",
      "html": "<a class=\"ds-stub\" href=\"#\">Start free — 14 days</a>",
      "css": ".ds-stub{position:relative;display:inline-flex;align-items:center;min-height:52px;padding:0 30px;color:#fff;background:#2b3a8f;font:800 16px Archivo,system-ui,sans-serif;text-decoration:none;border-radius:4px;-webkit-mask:radial-gradient(circle 9px at 0 50%,transparent 98%,#000) left/51% 100% no-repeat,radial-gradient(circle 9px at 100% 50%,transparent 98%,#000) right/51% 100% no-repeat;mask:radial-gradient(circle 9px at 0 50%,transparent 98%,#000) left/51% 100% no-repeat,radial-gradient(circle 9px at 100% 50%,transparent 98%,#000) right/51% 100% no-repeat;transition:background-color 150ms cubic-bezier(.23,1,.32,1),transform 150ms cubic-bezier(.23,1,.32,1)}.ds-stub::after{content:\"\";position:absolute;inset:8px auto 8px 17px;border-left:1.5px dashed rgba(255,255,255,.45)}.ds-stub:hover{background:#1f2b70}.ds-stub:active{transform:translateY(1px)}.ds-stub:focus-visible{outline:2.5px solid #2b3a8f;outline-offset:3px}"
    },
    {
      "name": "Tear button",
      "kind": "button",
