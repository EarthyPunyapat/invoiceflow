  "narrative": {
    "northStar": "The Duplicate Invoice Book",
    "overview": "The public site is the carbonless invoice book a freelancer keeps in the van: a white top copy goes to the client, canary and pink carbons stay behind, and a rubber stamp says PAID. The landing's first viewport is a working docket you type on, tear off to send and see stamped; legal pages and the public invoice are single printed sheets. The logged-in workspace keeps the previous evergreen system until it moves into this world.",
    "keyCharacteristics": [
      "Full-strength canary and pink plies on a cool carbon-blue desk",
      "Archivo form lettering beside Courier Prime typed entries",
      "Red only for serials and stamps",
      "Ticket-stub primary actions, perforations and torn edges",
      "Tear and stamp motion with instant reduced-motion fallbacks"
    ],
    "rules": [
      {
        "name": "One ink, one job",
        "body": "Blue prints the form, red marks money moving, typewriter ink records entries, canary and pink are the copies you keep.",
        "section": "colors"
      },
      {
        "name": "Stamps never cover figures",
        "body": "Stamps land in blank paper; every amount stays legible in every state and width.",
        "section": "colors"
      },
      {
        "name": "Typed is for entries, not reading",
        "body": "Courier Prime sets entries, data and short answers; long reading copy stays in Archivo.",
        "section": "typography"
      },
      {
        "name": "Paper on a desk",
        "body": "Flat sheets with one soft stack shadow; no glass, glows or hard offset shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do label every demonstration as an example",
      "Do keep amounts crisp on every surface",
      "Do theme selection, caret, focus and scrollbars from the palette",
      "Do keep a freelancer's accent on rules, never on text that could fail contrast"
    ],
    "donts": [
      "Don't put a label or eyebrow above a heading",
      "Don't drift toward cream or lamplight grounds",
      "Don't use stock photography, icon tiles or glyph icons",
      "Don't invent customers, statistics or prices"
    ]
  }
