      "css": ".ds-field{display:grid;grid-template-columns:7.2rem 1fr;align-items:end;gap:12px;padding:7px 0;background:#fff}.ds-field span{color:#2b3a8f;font:700 12.5px Archivo,system-ui,sans-serif;letter-spacing:.05em;text-transform:uppercase}.ds-field input{padding:4px 2px 3px;color:#1b1b22;background:transparent;border:0;border-bottom:1.5px dotted rgba(43,58,143,.6);font:400 1.12rem 'Courier Prime',ui-monospace,monospace;transition:background-color 150ms}.ds-field input:hover{background:rgba(255,216,61,.18)}.ds-field input:focus-visible{outline:none;background:rgba(255,216,61,.38);border-bottom:2px solid #2b3a8f}"
