      "css": ".ds-ply{position:relative;padding:30px 28px 22px;background:#fff;border-radius:0 0 4px 4px;box-shadow:0 3px 10px rgba(31,43,112,.1);color:#1b1b22;font:400 15px 'Courier Prime',ui-monospace,monospace}.ds-ply::before{content:\"\";position:absolute;inset:10px 0 auto;height:6px;background:radial-gradient(circle,#dce2f2 1.7px,transparent 2.2px) 0 50%/11px 6px repeat-x}.ds-ply-head{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:12px;margin-bottom:14px;border-bottom:2px solid rgba(43,58,143,.6)}.ds-ply-head span{color:#2b3a8f;font:800 1.3rem Archivo,system-ui,sans-serif;letter-spacing:.04em;text-transform:uppercase}.ds-ply-head b{color:#d7263d;font:700 1.1rem Archivo,system-ui,sans-serif;letter-spacing:.06em}"
