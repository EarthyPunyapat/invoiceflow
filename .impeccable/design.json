      "css": ".ds-stamp-btn{min-height:44px;padding:0 22px;color:#fff;background:#d7263d;border:0;border-radius:4px;font:800 15px Archivo,system-ui,sans-serif;cursor:pointer;transition:filter 150ms cubic-bezier(.23,1,.32,1)}.ds-stamp-btn:hover{filter:brightness(.92)}.ds-stamp-btn:focus-visible{outline:2.5px solid #2b3a8f;outline-offset:3px}"
