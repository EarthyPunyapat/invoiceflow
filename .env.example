# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoiceflow?schema=public"

# NextAuth
AUTH_SECRET="generate-a-random-secret-here"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend (email)
RESEND_API_KEY="re_..."
# From address shown on invoice delivery & reminder emails
RESEND_FROM_EMAIL="invoices@yourdomain.com"
# Where your own payment/activity notifications are delivered
FREELANCER_NOTIFY_EMAIL="you@yourdomain.com"

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Cron (bearer auth for /api/cron/* routes)
CRON_SECRET="generate-a-random-secret-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
