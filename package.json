{
  "name": "invoiceflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prepare-production-db.mjs && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "lint": "eslint src integration e2e scripts/prepare-production-db.mjs --ext .ts,.tsx,.mjs --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.0",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.460.0",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.25",
    "pdfkit": "^0.19.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resend": "^4.0.0",
    "stripe": "^17.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-email/components": "^0.0.25",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
